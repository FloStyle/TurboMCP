{
	"FileVersion": 3,
	"Version": 1,
	"VersionName": "1.0.0",
	"FriendlyName": "TurboMCP",
	"Description": "93 editor tools that fill the gaps in the engine's own MCP tools: Blueprint reading and writing, graph text, widgets, materials, capture, levels and actors.",
	"Category": "AI",
	"CreatedBy": "Florian ESCHALIER (FloStyle)",
	"CreatedByURL": "https://github.com/FloStyle",
	"DocsURL": "https://github.com/FloStyle/TurboMCP",
	"MarketplaceURL": "",
	"SupportURL": "https://github.com/FloStyle/TurboMCP/issues",
	"CanContainContent": true,
	"ExplicitlyLoaded": false,
	"IsBetaVersion": false,
	"IsExperimentalVersion": false,
	"Installed": false,
	"EnabledByDefault": false,
	"Modules": [
		{
			"Name": "TurboMCP",
			"Type": "Editor",
			"LoadingPhase": "PostEngineInit"
		}
	],
	"Plugins": [
		{
			"Name": "ModelContextProtocol",
			"Enabled": true
		},
		{
			"Name": "ToolsetRegistry",
			"Enabled": true
		},
		{
			"Name": "SlateInspectorToolset",
			"Enabled": true
		}
	]
}

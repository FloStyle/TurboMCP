{
  "schema": 2,
  "mode": "complete-tracked-tree",
  "forbidden_components": [
    ".git",
    ".agent",
    ".local",
    "provenance",
    "Binaries",
    "Intermediate",
    "Saved",
    "DerivedDataCache",
    "__pycache__"
  ],
  "forbidden_names": [
    "workspace.local.json",
    ".env"
  ],
  "forbidden_suffixes": [
    ".dll",
    ".exe",
    ".pdb",
    ".pem",
    ".key",
    ".zip"
  ],
  "scope": "Every tracked regular file at the same path. Refuse unsafe content; never silently omit it."
}
